# Copy this file to .env and replace the change-me values before running docker compose.

# MySQL container (db): the database is created and filled with initDb.sql on first start
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=esercitazione_api
MYSQL_USER=product_api
MYSQL_PASSWORD=change-me-db

# Producer (backend) connection to MySQL
MYSQL_HOSTNAME=db
MYSQL_PORT=3306
MYSQL_DATABASE_NAME=esercitazione_api
MYSQL_USERNAME=product_api

# HTTP Basic service account of the Producer, also used by the Consumer (frontend) for writes
API_USERNAME=admin
API_PASSWORD=change-me-api
